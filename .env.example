# Public HTTPS URL. Required for npm run build:hosting.
NEXT_PUBLIC_SITE_URL=
# Optional override. The verified studio map is embedded by default.
NEXT_PUBLIC_YANDEX_MAP_EMBED_URL=
# Configure legal information before publishing the policy as a final version.
NEXT_PUBLIC_OPERATOR_LEGAL_NAME=
NEXT_PUBLIC_OPERATOR_INN=
NEXT_PUBLIC_OPERATOR_OGRN=
NEXT_PUBLIC_OPERATOR_POSTAL_ADDRESS=
NEXT_PUBLIC_PRIVACY_EMAIL=
NEXT_PUBLIC_OPERATOR_PHONE=
# Optional. When set, the counter starts only after the visitor accepts analytics.
NEXT_PUBLIC_YANDEX_METRIKA_ID=
